{
  "name": "rentsight",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -b && npm run build:extension && npm run build:auth && npm run verify:build",
    "build:extension": "vite build",
    "build:auth": "vite build --config vite.auth.config.ts && node scripts/build-auth-assets.mjs",
    "verify:build": "node scripts/verify-extension-build.mjs",
    "deploy:auth": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:capture": "vitest run tests/capture",
    "test:e2e": "vitest run tests/aiExtraction.test.tsx tests/backend.test.ts",
    "test:watch": "vitest",
    "contract:generate": "node scripts/generate-extraction-contract.mjs",
    "test:fees": "vitest run tests/namedFeeWorkflow.test.tsx tests/feeFixWorkflow.test.tsx tests/feeExtraction.test.tsx tests/feeFormats.test.tsx tests/feeContractMatrix.test.tsx tests/realtorExtraction.test.tsx tests/aiFeeMapping.test.ts tests/extractors.test.ts tests/analysisIntegration.test.ts tests/savedListings.test.ts tests/aiExtraction.test.tsx tests/analysisEditorWorkflow.test.tsx tests/contentInspection.test.ts tests/capture",
    "test:fees:strict": "RENTSIGHT_REQUIRE_FEE_SUPPORT=1 npm run test:fees -- --reporter=verbose"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.18.0",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/chrome": "latest",
    "@types/jsdom": "^28.0.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "ajv": "^8.20.0",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
